# Sentinel docker-compose environment template.
# Copy to .env and replace every <PLACEHOLDER>. Never commit real secrets.
# The controller-specific settings live in apps/controller/.env (see its example).

# --- Images ---
CONTROLLER_IMAGE=sentinel-controller
CONTROLLER_TAG=local
BUN_VERSION=1.3.11
INSTALL_GH_CLI=true

# --- Controller ---
CONTROLLER_PORT=8787
CONTROLLER_ENV_FILE=apps/controller/.env
CONTROLLER_DATA_DIR=./data

# --- Demo application (profile: demo) ---
DEMO_IMAGE=sentinel-demo-app
DEMO_APP_TAG=good
DEMO_APP_PORT=3000
DEMO_FAULT_MODE=healthy

# --- Sentry (optional, advisory evidence only) ---
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# SENTRY_BASE_URL=https://sentry.io

# --- Multi-target configuration (optional JSON array) ---
# When set, overrides the single-target environment. See docs/vm-deployment.md.
# CONTROLLER_TARGETS=[]