# Monitored demo application image.
#
# This is deliberately separate from the controller image. The demo app is the
# thing Sentinel watches and can be broken on purpose; the controller must keep
# running when it is unhealthy.
#
# Build a known-good and a deliberately broken variant by changing DEMO_FAULT_MODE
# at runtime, or pin an image tag per version (for example :good and :broken) so
# a rollback has a concrete previous image to restore.
ARG BUN_VERSION=1.3.11
FROM oven/bun:${BUN_VERSION}

WORKDIR /app
COPY package.json bun.lock ./
COPY apps/sample/package.json apps/sample/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY apps/controller/package.json apps/controller/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/notifier/package.json packages/notifier/package.json
COPY packages/remediator/package.json packages/remediator/package.json
RUN bun install --frozen-lockfile

COPY packages packages
COPY apps/sample apps/sample
WORKDIR /app/apps/sample
RUN bun run build

ENV NODE_ENV=production
ENV PORT=3000
ENV DEMO_FAULT_MODE=healthy
EXPOSE 3000

USER bun
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/api/health" >/dev/null || exit 1

CMD ["bun", "run", "start"]