# Monitoring is off by default. Never commit real credentials.
CONTROLLER_MONITOR_ENABLED=false
CONTROLLER_ROLLBACK_ENABLED=false
CONTROLLER_ROLLBACK_PROJECT_ID=
CONTROLLER_PLATFORM=vercel
CONTROLLER_REMEDIATION_ENABLED=false
CONTROLLER_POLL_INTERVAL_MS=30000
CONTROLLER_DEPLOYMENT_STATUS_INTERVAL_MS=60000
# Scheduled deployment-log pull cadence in ms (60000-600000, default 300000)
CONTROLLER_LOGS_INTERVAL_MS=30000
CONTROLLER_PROBE_PATH=/api/tasks
CONTROLLER_PORT=8787
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123
# Signs the login cookie. Set the same value in Coolify so a restart does not log the dashboard out.
DASHBOARD_AUTH_SECRET=

# SMTP transport configuration. SMTP_TO is the user-configured alert recipient.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local-only secret that lets the CLI start an agent run. Without it the feed is read-only.
NEXATHON_RUN_TOKEN=

# Configure only for the dedicated demo Vercel project.
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_PRODUCTION_DOMAIN=
VERCEL_TEAM_ID=

# Configure one alternative platform when CONTROLLER_PLATFORM selects it.
# Railway uses a service-scoped ID for monitoring/rollback and logs are queried
# through Railway's GraphQL API.
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PRODUCTION_URL=

# Render log queries need the workspace owner ID as well as the service ID.
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_SERVICE_ID=
RENDER_PRODUCTION_URL=

# For self-hosted Coolify, use the trusted control-plane origin (without /api/v1).
COOLIFY_API_TOKEN=
COOLIFY_BASE_URL=
COOLIFY_APPLICATION_ID=
COOLIFY_PRODUCTION_URL=

# Trusted fix-PR configuration. Required only when remediation is enabled.
REMEDIATOR_REPOSITORY=iotserver24/nexathon
REMEDIATOR_SETUP_COMMAND=bun install --frozen-lockfile --filter ./apps/sample
REMEDIATOR_REPRODUCE_COMMAND=bun test apps/sample/tests/filter.repro.test.ts
REMEDIATOR_TEST_COMMAND=bun run --cwd apps/sample test
REMEDIATOR_BUILD_COMMAND=bun run --cwd apps/sample build
REMEDIATOR_FIXTURE_PATH=apps/sample/tests/filter.repro.test.ts
REMEDIATOR_FIXTURE_SOURCE=packages/remediator/fixtures/task-filter.repro.ts.txt
REMEDIATOR_MODEL_NAME=dedicated-remediator
REMEDIATOR_MODEL_ID=
REMEDIATOR_MODEL_BASE_URL=
REMEDIATOR_MODEL_API_BACKEND=responses
REMEDIATOR_MODEL_API_KEY=
GITHUB_READ_TOKEN=
SLACK_WEBHOOK_URL=
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PUBLIC_ORIGIN=
GITHUB_WEBHOOK_SECRET=

# --- HTTP error classification policy (see docs/http-classification.md) ---
# Comma-separated status codes. Invalid values fall back to the default policy.
CONTROLLER_IGNORED_STATUSES=404
CONTROLLER_WARNING_STATUSES=400,401,403,405,408,409,410,422,429
CONTROLLER_INCIDENT_STATUSES=500,501,502,503,504,507,508
# Routes expected to always exist; a 404 here is a real incident.
CONTROLLER_CRITICAL_ROUTES=/api/health
CONTROLLER_REPEAT_THRESHOLD=3
CONTROLLER_404_SPIKE_MULTIPLIER=5

# --- Dashboard roles (authorization) ---
# The admin credential is DASHBOARD_USERNAME / DASHBOARD_PASSWORD above.
# Optional lower-privilege credentials; omit to disable that role.
DASHBOARD_OPERATOR_USERNAME=
DASHBOARD_OPERATOR_PASSWORD=
DASHBOARD_VIEWER_USERNAME=
DASHBOARD_VIEWER_PASSWORD=
# Login attempts per client per five minutes, and sensitive operations per minute.
CONTROLLER_LOGIN_RATE_LIMIT=10
CONTROLLER_ACTION_RATE_LIMIT=30

# --- Multi-target monitoring (optional) ---
# JSON array of target definitions. When set, this replaces the single-target
# Vercel/Railway/Render/Coolify environment. See docs/multi-target.md.
CONTROLLER_TARGETS=

# --- VM deployment target (optional; see docs/vm-deployment.md) ---
# Base URL of the restricted VM agent and the application it may act on.
VM_AGENT_URL=
VM_AGENT_TOKEN=
VM_APPLICATION=

# --- Local demo monitor (fault injection against a local TaskFlow app) ---
CONTROLLER_DEMO_BASE_URL=
CONTROLLER_DEMO_POLL_INTERVAL_MS=5000
CONTROLLER_DEMO_DETECTION_THRESHOLD=1

# --- Sentry (optional advisory evidence; never triggers an action alone) ---
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_BASE_URL=

# --- Dependency / import policy for AI patches (see docs/dependency-policy.md) ---
# Path to a JSON policy file. Unset uses the built-in defaults.
REMEDIATOR_DEPENDENCY_POLICY_FILE=

# --- GitHub PR comment follow-up ---
# Comma-separated GitHub logins allowed to command the agent on a PR.
GITHUB_COMMAND_ALLOWLIST=
GITHUB_COMMAND_MENTION=@sentinel
# Set when the sandbox provider supports resuming a previous sandbox.
E2B_RESUME_SUPPORTED=false
E2B_LAST_SANDBOX_ID=
E2B_LAST_SANDBOX_EXPIRES=
